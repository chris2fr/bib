# bibman : copiez ce fichier en .env (non versionné) et ajustez. Une variable déjà définie dans l'environnement l'emporte.
# BIBMAN_ENV_FILE=/chemin/autre.env       # autre emplacement pour ce fichier (variable d'environnement uniquement)

# Données
# FR_DB=./biblio.db                       # base SQLite (python manage.py loadjson biblio.json la construit)
# BIBMAN_FILES=./files                    # dossier des fichiers sources : <clé>.pdf ou le nom du champ file
# FR_SYNONYMS=./synonyms.txt              # synonymes de la recherche
# FR_TOOLS_LIB=./outils/lib               # dossier de frlib.py et json2db.py

# Ordre des champs (noms séparés par des virgules ; les autres suivent par ordre alphabétique ; vide = tout alphabétique)
# BIBMAN_ORDER_BIBTEX=title,author,date,year
# BIBMAN_ORDER_OTHER=

# Mode
# FR_READONLY=1                           # consultation seule

# Django (obligatoire hors usage local)
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=changez-moi
# DJANGO_ALLOWED_HOSTS=bib.example.org,localhost
# BIBMAN_STATIC_ROOT=./staticfiles        # destination de collectstatic
